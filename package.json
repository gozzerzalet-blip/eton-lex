{
  "name": "eton-lex",
  "private": true,
  "version": "0.1.0",
  "description": "ETON LEX — Ecosistema jurídico inteligente para estudiantes de Derecho del Perú",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "start": "npm --workspace apps/api run start",
    "start:production": "node apps/api/dist/db/migrate.js && node apps/api/dist/db/seed.js && node apps/api/dist/scripts/import-corpus.js && node apps/api/dist/server.js",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:restore": "npm --workspace apps/api run db:restore --",
    "db:seed": "npm --workspace apps/api run db:seed",
    "db:migrate:prod": "node apps/api/dist/db/migrate.js",
    "db:seed:prod": "node apps/api/dist/db/seed.js",
    "backup": "node apps/api/dist/scripts/backup.js",
    "deploy:check": "node scripts/deploy-check.mjs",
    "ingest": "npm --workspace apps/api run ingest",
    "test": "npm --workspace apps/api run test",
    "e2e": "npm --workspace apps/api run e2e",
    "typecheck": "npm --workspace apps/web run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
