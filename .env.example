# ─────────────────────────────────────────────────────────────
#  ETON LEX — configuración
#  Copia este archivo a  .env  y completa lo que tengas.
#  NADA de lo que está vacío se simula: la UI lo muestra como
#  "no configurado" en lugar de fingir que funciona.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# URL pública oficial. En producción: https://tu-dominio (sin barra final).
# Alimenta canonical, Open Graph, robots.txt y sitemap.xml.
PUBLIC_WEB_URL=http://localhost:4000

# Clave para firmar tokens. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Ruta de la base de datos SQLite (por defecto apps/api/data/eton-lex.db)
# DATABASE_PATH=

# ── Inteligencia artificial ──────────────────────────────────
# Proveedor: openai | anthropic | google | openrouter | pollinations | ollama | none
# pollinations y ollama funcionan sin clave de API.
# Producción recomendada (rápida y sin depender de esta PC): Groq compatible con OpenAI:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_API_KEY=<clave de https://console.groq.com/keys>
#   AI_FALLBACK_PROVIDER=pollinations
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Solo para proveedores compatibles con OpenAI (openrouter, pollinations, ollama, groq…)
AI_BASE_URL=
# Respaldo automático si el proveedor principal falla antes de responder.
# Sirve, por ejemplo, para caer al modelo local cuando la nube limita el uso.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
# Calidad y tamaño de la respuesta.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=900
AI_HISTORY=8
# Caracteres de contexto que recibe el modelo (bajar en CPU) y número de
# bloques de biblioteca recuperados por consulta.
AI_CONTEXT_CHARS=20000
AI_LIBRARY_BLOCKS=8
# Investigación web sin API key (DuckDuckGo + lectura de la página).
AI_WEB_RESEARCH=true
AI_WEB_SOURCES=3
AI_WEB_TIMEOUT_MS=15000
AI_WEB_PAGE_CHARS=2500
# Modelo de embeddings. Si se deja vacío, ETON AI usa búsqueda léxica
# (FTS5) sobre el corpus jurídico, que también es real y verificable.
EMBEDDING_MODEL=

# ── Noticias y fuentes oficiales ─────────────────────────────
# Feeds RSS/Atom separados por coma. Si están vacíos, el módulo
# ETON NEWS informa "sin fuentes configuradas" (no inventa noticias).
NEWS_FEEDS=
# Opcional: NewsAPI para cobertura adicional
NEWSAPI_KEY=

# ── Mensajería / llamadas ────────────────────────────────────
# STUN/TURN para WebRTC. Sin TURN, las llamadas funcionan en la
# mayoría de redes domésticas, pero pueden fallar tras NAT estricto.
WEBRTC_STUN=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USER=
WEBRTC_TURN_PASS=

# ── Correo (verificación de cuenta / recuperación) ───────────
# Si está vacío, el registro funciona pero la verificación de
# correo queda marcada como PENDIENTE en el perfil.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ETON LEX <no-reply@etonlex.pe>

# ── Almacenamiento ───────────────────────────────────────────
MAX_UPLOAD_MB=25
