# ETON LEX · production
# Copia a .env.production y completa. NUNCA subas ese archivo a Git.

# Dominio definitivo (sin https:// y sin barra final)
DOMAIN=etonlex.com
ADMIN_EMAIL=zalet@ejemplo.com
PUBLIC_WEB_URL=https://etonlex.com
WEB_ORIGIN=https://etonlex.com

NODE_ENV=production
PORT=4000
DEMO_MODE=false

# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_96_HEX

# Persistencia dentro del volumen /data
DATA_DIR=/data
DATABASE_PATH=/data/eton-lex.db
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14
MAX_UPLOAD_MB=25

# ── ETON AI ─────────────────────────────────────────────────
# Recomendado: Groq (compatible con OpenAI, rápido y en la nube).
# Obtén la clave en https://console.groq.com/keys
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# Respaldo sin clave y sin depender de esta PC:
AI_FALLBACK_PROVIDER=pollinations
AI_FALLBACK_MODEL=openai-fast
AI_FALLBACK_BASE_URL=https://text.pollinations.ai
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=900
AI_HISTORY=12
AI_CONTEXT_CHARS=20000
AI_LIBRARY_BLOCKS=8
AI_WEB_RESEARCH=true
AI_WEB_SOURCES=3
AI_WEB_TIMEOUT_MS=15000
EMBEDDING_MODEL=

# ── Correo (verificación y recuperación) ───────────────────
# Recomendado: Resend, Brevo o Gmail SMTP (contraseña de aplicación).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ETON LEX <no-reply@etonlex.com>

# ── Fuentes y mensajería (opcional) ────────────────────────
NEWS_FEEDS=
NEWSAPI_KEY=
WEBRTC_STUN=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USER=
WEBRTC_TURN_PASS=

# ── Cuenta administradora (solo en el primer arranque) ────
SEED_ADMIN_EMAIL=zalet@ejemplo.com
SEED_ADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASEÑA_LARGA
SEED_ADMIN_NAME=Zalet Gozzer
